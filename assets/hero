&lt;script&gt;
/**
 * Obada Outabachi - Deep Space Floating Weightless Vector Animation
 * Strictly Dark / Desaturated Monochrome / Obsidian &amp; Brushed Gunmetal
 */
(function() {
  const WIDTH = 1200;
  const HEIGHT = 700;
  const CX = 600;
  const CY = 350;

  // DOM Elements
  const heroCluster = document.getElementById('heroCluster');
  const gleamSweep = document.getElementById('gleamSweep');
  const nebulaGroup = document.getElementById('nebulaGroup');
  const layerDeepDust = document.getElementById('layerDeepDust');
  const neuralNodesGroup = document.getElementById('neuralNodesGroup');
  const neuralLinesPath = document.getElementById('neuralLinesPath');
  const drone1 = document.getElementById('drone1');
  const drone2 = document.getElementById('drone2');
  const drone3 = document.getElementById('drone3');
  const aiRelic1 = document.getElementById('aiRelic1');
  const aiRelic2 = document.getElementById('aiRelic2');

  // Animation State &amp; Controls
  let isRunning = false;
  let animFrameId = null;
  let startTime = null;

  // 1. One-time Setup: Stardust &amp; Particles (Fixed seed initialization)
  const particles = [];
  const PARTICLE_COUNT = 64;
  for (let i = 0; i &lt; PARTICLE_COUNT; i++) {
    const p = {
      x: (Math.sin(i * 99.7) * 0.5 + 0.5) * WIDTH,
      y: (Math.cos(i * 33.1) * 0.5 + 0.5) * HEIGHT,
      r: (i % 7 === 0) ? 1.5 : (i % 3 === 0 ? 1.0 : 0.6),
      speedX: ((i % 5) - 2) * 0.04 - 0.02,
      speedY: -0.06 - ((i % 4) * 0.02),
      baseOpacity: 0.15 + (i % 5) * 0.1,
      twinkleFreq: 0.001 + (i % 9) * 0.0006,
      twinklePhase: i * 1.7
    };
    particles.push(p);

    const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    circle.setAttribute('cx', p.x);
    circle.setAttribute('cy', p.y);
    circle.setAttribute('r', p.r);
    circle.setAttribute('fill', i % 4 === 0 ? '#8da0b8' : '#4b5563');
    circle.setAttribute('opacity', p.baseOpacity);
    layerDeepDust.appendChild(circle);
    p.el = circle;
  }

  // 2. One-time Setup: Neural Network Nodes &amp; Mesh
  const nodes = [
    { x: 120, y: 220, vx: 0.015, vy: 0.012 },
    { x: 260, y: 150, vx: -0.012, vy: 0.018 },
    { x: 380, y: 280, vx: 0.014, vy: -0.015 },
    { x: 220, y: 390, vx: -0.018, vy: -0.01 },
    { x: 440, y: 460, vx: 0.01, vy: 0.014 },
    { x: 780, y: 180, vx: -0.015, vy: -0.012 },
    { x: 920, y: 130, vx: 0.018, vy: 0.015 },
    { x: 1060, y: 260, vx: -0.012, vy: 0.02 },
    { x: 860, y: 420, vx: 0.016, vy: -0.014 },
    { x: 1020, y: 520, vx: -0.014, vy: -0.016 },
    { x: 600, y: 580, vx: 0.012, vy: -0.01 }
  ];

  nodes.forEach((node, idx) =&gt; {
    node.ox = node.x;
    node.oy = node.y;
    const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    c.setAttribute('cx', node.x);
    c.setAttribute('cy', node.y);
    c.setAttribute('r', '2.2');
    c.setAttribute('fill', '#4b5568');
    neuralNodesGroup.appendChild(c);
    node.el = c;
  });

  // Neural Line Adjacency
  const edges = [
    [0, 1], [1, 2], [0, 3], [2, 3], [2, 4], [3, 4],
    [5, 6], [6, 7], [5, 8], [7, 8], [7, 9], [8, 9],
    [4, 10], [8, 10]
  ];

  // 3. Main Loop
  function tick(timestamp) {
    if (!startTime) startTime = timestamp;
    const elapsed = timestamp - startTime;

    // A. Main Floating Weightless Levitation (Sinusoidal Physics)
    // Multi-harmonic gentle drift for ultra-organic floating
    const floatY = Math.sin(elapsed * 0.00095) * 11 + Math.sin(elapsed * 0.0017) * 3.5;
    const floatX = Math.cos(elapsed * 0.00062) * 5;
    const tiltRot = Math.sin(elapsed * 0.00085 + 0.4) * 1.15;
    const microScale = 1 + Math.sin(elapsed * 0.0007) * 0.006;

    heroCluster.setAttribute(
      'transform',
      `translate(${CX + floatX}, ${CY + floatY}) rotate(${tiltRot}) scale(${microScale})`
    );

    // B. Sweeping Gleam on Typography (periodic slow sweep)
    const gleamCycle = (elapsed * 0.28) % 2400; // resets every 2.4s
    const gleamPos = -700 + gleamCycle;
    gleamSweep.setAttribute('x', gleamPos);

    // C. Deep Nebular Shift (Parallax Drift)
    const nebX = Math.sin(elapsed * 0.0003) * 16;
    const nebY = Math.cos(elapsed * 0.0004) * 12;
    nebulaGroup.setAttribute('transform', `translate(${nebX}, ${nebY})`);

    // D. Particle Dust Motion &amp; Twinkling
    for (let i = 0; i &lt; PARTICLE_COUNT; i++) {
      const p = particles[i];
      let curX = (p.x + elapsed * p.speedX) % WIDTH;
      if (curX &lt; 0) curX += WIDTH;
      let curY = (p.y + elapsed * p.speedY) % HEIGHT;
      if (curY &lt; 0) curY += HEIGHT;

      p.el.setAttribute('cx', curX);
      p.el.setAttribute('cy', curY);

      const tw = p.baseOpacity + Math.sin(elapsed * p.twinkleFreq + p.twinklePhase) * 0.18;
      p.el.setAttribute('opacity', Math.max(0.04, Math.min(0.85, tw)));
    }

    // E. Neural Network Motion &amp; Edge Recomputation
    nodes.forEach((n, i) =&gt; {
      n.x = n.ox + Math.sin(elapsed * 0.0008 + i) * 14;
      n.y = n.oy + Math.cos(elapsed * 0.0009 + i * 1.3) * 10;
      n.el.setAttribute('cx', n.x);
      n.el.setAttribute('cy', n.y);
    });

    let pathD = '';
    for (let j = 0; j &lt; edges.length; j++) {
      const [a, b] = edges[j];
      pathD += `M ${nodes[a].x} ${nodes[a].y} L ${nodes[b].x} ${nodes[b].y} `;
    }
    neuralLinesPath.setAttribute('d', pathD);

    // F. Micro Probes &amp; Autonomous AI Element Orbital Drifts
    // Drone 1 (Slow patrol left)
    const d1x = 240 + Math.sin(elapsed * 0.0007) * 28;
    const d1y = 480 + Math.cos(elapsed * 0.0009) * 18;
    const d1rot = Math.sin(elapsed * 0.001) * 8 - 10;
    drone1.setAttribute('transform', `translate(${d1x}, ${d1y}) rotate(${d1rot})`);

    // Drone 2 (Top-right reconnaissance)
    const d2x = 960 + Math.cos(elapsed * 0.0008) * 32;
    const d2y = 220 + Math.sin(elapsed * 0.0011) * 16;
    const d2rot = 15 + Math.sin(elapsed * 0.0012) * 12;
    drone2.setAttribute('transform', `translate(${d2x}, ${d2y}) rotate(${d2rot})`);

    // Drone 3 (High altitude probe)
    const d3x = 560 + Math.sin(elapsed * 0.0005) * 45;
    const d3y = 120 + Math.cos(elapsed * 0.0006) * 10;
    drone3.setAttribute('transform', `translate(${d3x}, ${d3y}) rotate(-40)`);

    // AI Silhouette Relics Parallax Breathing
    const r1Rot = (elapsed * 0.004) % 360;
    aiRelic1.setAttribute('transform', `translate(${180 + Math.sin(elapsed * 0.0004) * 10}, ${160 + Math.cos(elapsed * 0.0005) * 8}) scale(1.6) rotate(${r1Rot} 12 12)`);
    
    const r2Rot = 35 + Math.sin(elapsed * 0.0006) * 14;
    aiRelic2.setAttribute('transform', `translate(${1010 - Math.cos(elapsed * 0.0005) * 12}, ${480 + Math.sin(elapsed * 0.0004) * 10}) scale(1.2) rotate(${r2Rot} 12 12)`);

    if (isRunning) {
      animFrameId = requestAnimationFrame(tick);
    }
  }

  // 4. Standard Animation Protocol Interface
  window.startAnimation = function() {
    if (!isRunning) {
      isRunning = true;
      startTime = null;
      animFrameId = requestAnimationFrame(tick);
    }
  };

  window.stopAnimation = function() {
    isRunning = false;
    if (animFrameId) {
      cancelAnimationFrame(animFrameId);
      animFrameId = null;
    }
  };

  window.resetAnimation = function() {
    window.stopAnimation();
    startTime = null;
    heroCluster.setAttribute('transform', `translate(${CX}, ${CY})`);
    gleamSweep.setAttribute('x', -600);
    window.startAnimation();
  };

  // Auto-start on load
  window.startAnimation();
})();
&lt;/script&gt;
