        &lt;line x1=&quot;-30&quot; y1=&quot;0&quot; x2=&quot;30&quot; y2=&quot;0&quot; stroke=&quot;#718096&quot; stroke-width=&quot;1.4&quot;/&gt;
        &lt;!-- Text --&gt;
        &lt;text y=&quot;22&quot; text-anchor=&quot;middle&quot; fill=&quot;#6b7a90&quot; font-size=&quot;11&quot; font-family=&quot;monospace&quot; letter-spacing=&quot;7&quot; font-weight=&quot;500&quot;&gt;
          AUTONOMOUS SYSTEMS // ZERO GRAVITY
        &lt;/text&gt;
      &lt;/g&gt;

      &lt;!-- Sleek Bracket Accents --&gt;
      &lt;path d=&quot;M -490 -45 L -510 -45 L -510 45 L -490 45&quot; fill=&quot;none&quot; stroke=&quot;#36404e&quot; stroke-width=&quot;1.5&quot; opacity=&quot;0.5&quot;/&gt;
      &lt;path d=&quot;M 490 -45 L 510 -45 L 510 45 L 490 45&quot; fill=&quot;none&quot; stroke=&quot;#36404e&quot; stroke-width=&quot;1.5&quot; opacity=&quot;0.5&quot;/&gt;
    &lt;/g&gt;

    &lt;!-- Foreground Vignette Mask --&gt;
    &lt;rect width=&quot;1200&quot; height=&quot;700&quot; fill=&quot;none&quot; stroke=&quot;#040507&quot; stroke-width=&quot;2&quot; pointer-events=&quot;none&quot;/&gt;
  &lt;/svg&gt;
